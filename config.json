{
  "publicConfig": true,
  "version": "8.10.0-public-safe",
  "security": {
    "mode": "drive-protected",
    "note": "GitHub Pages enthaelt nur die App-Huelle. Private Finanzdaten gehoeren in Google Drive und in den lokalen Browser-Speicher nach Anmeldung."
  },
  "financialMonthStartDay": 15,
  "financeCycle": {
    "anchorDay": 15
  },
  "overdraftLimit": 0,
  "currentSnapshot": {
    "balance": 0,
    "date": ""
  },
  "plan": {
    "emergencyBuffer": 0,
    "vacationSavings": 0,
    "plannedPaydown": 0
  },
  "dues": [],
  "recurrences": [],
  "drive": {
    "clientId": "",
    "scope": "https://www.googleapis.com/auth/drive.file",
    "fileName": "AT_HUB_Finanzen_v1.json",
    "privateConfigFileName": "AT_HUB_Finanzconfig_v1.json",
    "autoSync": true,
    "syncIntervalSeconds": 60
  }
}
